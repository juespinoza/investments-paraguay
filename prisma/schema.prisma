// schema.prisma
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INMOBILIARIA
  ASESOR
  BLOGUERO
}

enum BlogOwnerType {
  ADMIN
  INMOBILIARIA
  ADVISOR
  BLOGGER
}

enum SocialPlatform {
  WHATSAPP
  EMAIL
  BLOG
  WEB
  INSTAGRAM
  FACEBOOK
  X
  TIKTOK
}

enum Supercategory {
  CONOCER
  VIVIR
  INVERTIR
}

enum Currency {
  GS
  USD
}

enum PropertyStatus {
  EN_VENTA
  EN_ALQUILER
  RESERVADA
  BORRADOR
  VENDIDA
  ALQUILADA
  RETIRADA
}

enum Orientation {
  NORTE
  SUR
  ESTE
  OESTE
}

enum FeatureCategory {
  EQUIPMENT
  AMENITY
  SECURITY
  GENERAL_SERVICE
  PAYMENT_METHOD
  FINANCING_TYPE
  REQUIRED_DOCUMENT
}

enum CompanyType {
  CONSTRUCTORA
  DESARROLLADORA
}

enum BalconyType {
  SIN_BALCON
  CON_BALCON
  CON_PARRILLA
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  password String
  role     Role    @default(ASESOR)

  inmobiliariaId String?
  advisorId      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Inmobiliaria {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  themeJson   Json?

  landing    InmobiliariaLanding?
  blogs      BlogPost[]
  properties Property[]
  advisors   Advisor[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Advisor {
  id        String  @id @default(cuid())
  fullName  String
  slug      String  @unique
  bio       String?
  phone     String?
  whatsapp  String?
  instagram String?
  photoUrl  String?

  blogs      BlogPost[]
  properties Property[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Landing base fields
  headline  String? // slogan
  heroBgUrl String? // background puede ser null
  ctaLabel  String? // por defecto lo setearás desde UI
  ctaHref   String?

  // Relación opcional con inmobiliaria
  inmobiliariaId String?
  inmobiliaria   Inmobiliaria? @relation(fields: [inmobiliariaId], references: [id])

  // 1:1 landing editable
  landing LandingAdvisor?
}

model Property {
  id                    String                           @id @default(cuid())
  title                 String
  slug                  String                           @unique
  price                 Decimal?                         @db.Decimal(14, 2)
  currency              Currency                         @default(USD)
  status                PropertyStatus                   @default(BORRADOR)
  hasPropertyDocuments  Boolean                          @default(false)
  propertyTypeId        String
  propertyType          PropertyType                     @relation(fields: [propertyTypeId], references: [id], onDelete: Restrict)
  areaM2                Decimal?                         @db.Decimal(8, 2)
  city                  String?
  neighborhood          String?
  address               String?
  locationUrl           String?
  latitude              Decimal?                         @db.Decimal(9, 6)
  longitude             Decimal?                         @db.Decimal(9, 6)
  roiAnnualPct          Decimal?                         @db.Decimal(5, 2)
  appreciationAnnualPct Decimal?                         @db.Decimal(5, 2)
  isFeatured            Boolean                          @default(false)
  featuredOrder         Int?
  description           String?
  coverImageUrl         String?
  gallery               String[] // simple
  inmobiliariaId        String?
  inmobiliaria          Inmobiliaria?                    @relation(fields: [inmobiliariaId], references: [id])
  advisorId             String?
  advisor               Advisor?                         @relation(fields: [advisorId], references: [id])
  categories            PropertyCategory[]
  residentialDetails    PropertyResidentialDetails?
  features              PropertyFeature[]
  investmentDetails     PropertyInvestmentDetails?
  typologies            PropertyTypology[]
  featuredInLandings    LandingAdvisorFeaturedProperty[]
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  deletedAt             DateTime?

  @@index([city])
  @@index([status])
  @@index([propertyTypeId])
  @@index([isFeatured, featuredOrder, updatedAt])
}

model PropertyType {
  id                    String     @id @default(cuid())
  code                  String     @unique
  label                 String
  isProject             Boolean    @default(false)
  hasResidentialDetails Boolean    @default(false)
  isActive              Boolean    @default(true)
  properties            Property[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model PropertyCategory {
  id         String        @id @default(cuid())
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category   Supercategory
  createdAt  DateTime      @default(now())

  @@unique([propertyId, category])
  @@index([category])
}

model PropertyResidentialDetails {
  id          String       @id @default(cuid())
  propertyId  String       @unique
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bedrooms    Int?
  bathrooms   Int?
  garages     Int?
  orientation Orientation?
  petFriendly Boolean      @default(false)
}

model Feature {
  id         String            @id @default(cuid())
  category   FeatureCategory
  code       String
  label      String
  isActive   Boolean           @default(true)
  properties PropertyFeature[]

  @@unique([category, code])
}

model PropertyFeature {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  featureId  String
  feature    Feature  @relation(fields: [featureId], references: [id])

  @@unique([propertyId, featureId])
  @@index([featureId])
}

model Company {
  id                              String                      @id @default(cuid())
  type                            CompanyType
  name                            String
  description                     String?                     @db.Text
  yearsExperience                 Int?
  completedProjects               Int?
  ongoingProjects                 Int?
  constructoraInvestmentDetails   PropertyInvestmentDetails[] @relation("InvestmentConstructora")
  desarrolladoraInvestmentDetails PropertyInvestmentDetails[] @relation("InvestmentDesarrolladora")
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt

  @@index([type])
  @@index([name])
}

model PropertyInvestmentDetails {
  id                       String   @id @default(cuid())
  propertyId               String   @unique
  property                 Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  constructionStartQuarter Int
  constructionStartYear    Int
  constructionEndQuarter   Int
  constructionEndYear      Int
  constructoraId           String?
  constructora             Company? @relation("InvestmentConstructora", fields: [constructoraId], references: [id], onDelete: SetNull)
  desarrolladoraId         String?
  desarrolladora           Company? @relation("InvestmentDesarrolladora", fields: [desarrolladoraId], references: [id], onDelete: SetNull)
  postSaleWarrantyYears    Int?

  @@index([constructoraId])
  @@index([desarrolladoraId])
}

model PropertyTypology {
  id                     String      @id @default(cuid())
  propertyId             String
  property               Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name                   String
  planImageUrl           String?
  interiorAreaM2         Decimal     @db.Decimal(8, 2)
  exteriorAreaM2         Decimal?    @db.Decimal(8, 2)
  bedrooms               Int
  bathrooms              Int
  garages                Int
  cashPrice              Decimal     @db.Decimal(14, 2)
  currency               Currency    @default(USD)
  balconyType            BalconyType
  expensesPerM2Approx    Decimal?    @db.Decimal(14, 2)
  netMonthlyIncomeApprox Decimal?    @db.Decimal(14, 2)
  roiCalculated          Decimal?    @db.Decimal(12, 6)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([propertyId])
}

model BlogPost {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  content       String
  coverImageUrl String?
  ownerType     BlogOwnerType?
  ownerId       String?

  inmobiliariaId String?
  inmobiliaria   Inmobiliaria? @relation(fields: [inmobiliariaId], references: [id])

  advisorId String?
  advisor   Advisor? @relation(fields: [advisorId], references: [id])

  authorRole Role

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerType, ownerId])
  @@index([authorRole])
}

model InmobiliariaLanding {
  id             String       @id @default(cuid())
  inmobiliariaId String       @unique
  inmobiliaria   Inmobiliaria @relation(fields: [inmobiliariaId], references: [id], onDelete: Cascade)
  themeJson      Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model LandingAdvisor {
  id        String  @id @default(cuid())
  advisorId String  @unique
  advisor   Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  // ABOUT
  aboutImageUrl    String
  aboutTitle       String
  startDate        DateTime
  company          String
  aboutDescription String?
  aboutParagraph1  String
  aboutParagraph2  String

  // SERVICES
  servicesParagraph1 String
  servicesParagraph2 String

  propertyTypes LandingAdvisorPropertyType[]
  clientTypes   LandingAdvisorClientType[]
  areas         LandingAdvisorArea[]
  serviceList   LandingAdvisorServiceItem[]

  // Featured properties (máx 3 por regla en backend)
  featuredProperties LandingAdvisorFeaturedProperty[]

  // Testimonios y redes (pueden estar acá para mantener "la landing" completa)
  testimonies AdvisorTestimonial[]
  socialMedia AdvisorSocialLink[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model LandingAdvisorPropertyType {
  id        String         @id @default(cuid())
  value     String
  landingId String
  landing   LandingAdvisor @relation(fields: [landingId], references: [id], onDelete: Cascade)

  @@index([landingId])
}

model LandingAdvisorClientType {
  id        String         @id @default(cuid())
  value     String
  landingId String
  landing   LandingAdvisor @relation(fields: [landingId], references: [id], onDelete: Cascade)

  @@index([landingId])
}

model LandingAdvisorArea {
  id        String         @id @default(cuid())
  value     String
  landingId String
  landing   LandingAdvisor @relation(fields: [landingId], references: [id], onDelete: Cascade)

  @@index([landingId])
}

model LandingAdvisorServiceItem {
  id        String         @id @default(cuid())
  value     String
  landingId String
  landing   LandingAdvisor @relation(fields: [landingId], references: [id], onDelete: Cascade)

  @@index([landingId])
}

model LandingAdvisorFeaturedProperty {
  id         String @id @default(cuid())
  landingId  String
  propertyId String
  order      Int

  landing  LandingAdvisor @relation(fields: [landingId], references: [id], onDelete: Cascade)
  property Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([landingId, propertyId])
  @@unique([landingId, order])
  @@index([landingId])
}

model AdvisorTestimonial {
  id   String @id @default(cuid())
  name String
  text String

  landingId String
  landing   LandingAdvisor @relation(fields: [landingId], references: [id], onDelete: Cascade)

  @@index([landingId])
}

model AdvisorSocialLink {
  id       String         @id @default(cuid())
  label    String
  value    String
  href     String
  platform SocialPlatform

  landingId String
  landing   LandingAdvisor @relation(fields: [landingId], references: [id], onDelete: Cascade)

  @@index([landingId])
}
